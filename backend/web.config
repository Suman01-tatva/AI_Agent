<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <!-- Keep FastCgi handler -->
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="D:\Project\chatbot_final\AI_Agent\backend\.venv\Scripts\python.exe|D:\Project\chatbot_final\AI_Agent\backend\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!-- Increase FastCGI timeouts to handle heavy imports like EasyOCR -->
    <fastCgi>
      <application
          fullPath="D:\Project\chatbot_final\AI_Agent\backend\.venv\Scripts\python.exe"
          arguments="D:\Project\chatbot_final\AI_Agent\backend\.venv\Lib\site-packages\wfastcgi.py"
          activityTimeout="300"
          requestTimeout="300"
          instanceMaxRequests="10000">
        <environmentVariables>
          <environmentVariable name="WSGI_HANDLER" value="app.application" />
          <environmentVariable name="PYTHONPATH" value="D:\Project\chatbot_final\AI_Agent\backend" />
          <environmentVariable name="WSGI_LOG" value="D:\Project\chatbot_final\AI_Agent\backend\wfastcgi.log" />
          <environmentVariable name="WSGI_ENCODING" value="utf-8" />
        </environmentVariables>
      </application>
    </fastCgi>

    <httpErrors errorMode="Detailed" />
    <asp scriptErrorSentToBrowser="true" />
  </system.webServer>
</configuration>
